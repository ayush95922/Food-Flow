# Copy to .env and adjust. All values are optional (defaults shown).
APP_NAME=Surplus Food AI Service
ENVIRONMENT=development
# Comma-separated list of allowed origins (React dev server, Spring Boot gateway)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Optional shared secret. If set, every /api/ai/* call (except /health) must send header X-API-Key.
API_KEY=
MAX_UPLOAD_MB=10
FOOD_MODEL_DIR=saved_models/food_classifier
USABLE_TIME_MODEL_DIR=saved_models/usable_time
# Routing/matching assumptions (SIMULATED travel estimates - not real road data)
DEFAULT_SPEED_KMPH=25
DETOUR_FACTOR=1.3
MAX_RADIUS_KM=15

# Food recognition backend: auto (local model, Groq fallback) | local | groq
FOOD_BACKEND=auto
# Get a key at https://console.groq.com . NEVER commit it or expose it to the React frontend.
GROQ_API_KEY=
# Check Groq's docs for the currently available vision-capable model name
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_S=30
# In auto mode also ask Groq when the local model is uncertain
GROQ_ON_UNCERTAIN=false
